{
  "name": "music-app-personal",
  "version": "0.1.0",
  "description": "Reproductor personal por modos de escucha, sobre tu propia biblioteca.",
  "author": "@terrikoladigital",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:movil": "vite build --mode movil",
    "build:android": "vite build --mode movil && cap sync android",
    "probar-audio": "node scripts/probar-audio-clientes.mjs",
    "preview": "vite preview",
    "importar": "node scripts/importar.mjs",
    "resolver": "node scripts/resolver-youtube.mjs",
    "clasificar-embeddings": "node scripts/enriquecer-embeddings.mjs",
    "diagnostico": "node scripts/diagnostico.mjs",
    "electron:dev": "electron .",
    "electron:build": "electron-builder",
    "empaquetar": "node scripts/empaquetar.mjs",
    "publicar-version": "node scripts/publicar-version.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@huggingface/transformers": "^4.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "music-metadata": "^11.15.0",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.1.12",
    "youtubei.js": "^18.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "onnxruntime-node@1.24.3": true,
    "protobufjs@7.6.5": true,
    "sharp@0.34.5": true
  },
  "build": {
    "appId": "com.terrikola.musicsippi",
    "productName": "Musicsippi",
    "directories": {
      "output": "C:/build-musicsippi"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "scripts/**/*",
      "public/**/*",
      "data/**/*",
      "index.html",
      "vite.config.js",
      "package.json",
      "LICENSE.txt",
      "version-build.json",
      "!graphify-out/**"
    ],
    "asar": false,
    "win": {
      "target": "nsis",
      "icon": "favicon-shortcut.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "LICENSE.txt"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/musicsippi-app-icon-512.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/musicsippi-app-icon-512.png"
    }
  }
}
